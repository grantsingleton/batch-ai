{
  "name": "batch-ai",
  "version": "2.0.0",
  "description": "A unified SDK for making batch AI requests across different model providers",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src/types.ts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:esm": "tsc",
    "build": "rm -rf dist && npm run build:esm && npm run build:cjs",
    "watch": "tsc --watch",
    "test": "jest",
    "lint": "eslint .",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "preversion": "npm run lint",
    "version": "git add -A src",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "ai",
    "batch",
    "openai",
    "anthropic",
    "llm",
    "sdk"
  ],
  "author": "Grant Singleton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grantsingleton/batch-ai.git"
  },
  "homepage": "https://github.com/grantsingleton/batch-ai#readme",
  "bugs": {
    "url": "https://github.com/grantsingleton/batch-ai/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": ">=4.9.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "openai": "^7.4.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
